{
  "name": "@refhaven/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:auth": "bun --env-file=../../packages/backend/.env.local checks/auth.ts",
    "check:canvas": "bun --env-file=../../packages/backend/.env.local checks/canvas.ts",
    "check:canvas-page": "bun --env-file=../../packages/backend/.env.local checks/canvas-page.ts",
    "check:collection-canvas": "bun --env-file=../../packages/backend/.env.local checks/collection-canvas.ts",
    "check:collections": "bun --env-file=../../packages/backend/.env.local checks/collections.ts",
    "check:confect": "bun --env-file=../../packages/backend/.env.local checks/confect.ts",
    "check:library": "bun --env-file=../../packages/backend/.env.local checks/library.ts",
    "check:paste-drop": "bun --env-file=../../packages/backend/.env.local checks/paste-drop.ts",
    "check:ref-page": "bun --env-file=../../packages/backend/.env.local checks/ref-page.ts",
    "check:renderer": "bun checks/renderer.ts",
    "check:trash": "bun --env-file=../../packages/backend/.env.local checks/trash.ts",
    "dev": "vite dev --port 3000 --strictPort",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p checks"
  },
  "dependencies": {
    "@confect/core": "10.6.0",
    "@confect/react": "10.6.0",
    "@convex-dev/auth": "2.0.0",
