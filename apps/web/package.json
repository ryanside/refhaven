    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@refhaven/backend": "workspace:*",
    "@refhaven/renderer": "workspace:*",
    "@refhaven/scene": "workspace:*",
    "@refhaven/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "convex": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
