{
  "name": "@refhaven/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./blob": "./confect/blob.ts",
    "./collection": "./confect/collection.ts",
    "./id": "./confect/_generated/id.ts",
    "./refFields": "./confect/refFields.ts",
    "./refs": "./confect/_generated/refs.ts"
  },
  "scripts": {
    "dev": "convex dev --tail-logs",
    "dev:codegen": "confect dev",
    "codegen": "confect codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@confect/core": "10.6.0",
    "@confect/server": "10.6.0",
    "@convex-dev/auth": "2.0.0",
    "@convex-dev/r2": "0.10.4",
    "@effect/platform-node": "4.1.4",
    "@refhaven/scene": "workspace:*",
    "convex": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@confect/cli": "10.6.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
